# Resend (transactional email) — required for /api/contact
RESEND_API_KEY=
CONTACT_TO_EMAIL=hola@unlimited.systems
CONTACT_FROM_EMAIL="UNLIMITED <noreply@unlimited.systems>"

# Optional: Slack webhook to mirror form submissions
SLACK_WEBHOOK_URL=

# Optional: Upstash Redis for rate limiting (5 req / 10 min per IP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public — exposed to the client
NEXT_PUBLIC_WA_NUMBER=34600000000
NEXT_PUBLIC_SITE_URL=https://unlimited.systems
